  ICO.PolarizationOrderedArbitraryControl.dilutedPlusSwitchMap lam mu Φ Ψ =
    (lam * mu) • ICO.PolarizationOrderedArbitraryControl.plusSwitchChannelMap Φ Ψ +
          (lam * (1 - mu)) • ICO.PolarizationOrderedArbitraryControl.plusSwitchChannelMap Φ LinearMap.id +
        ((1 - lam) * mu) • ICO.PolarizationOrderedArbitraryControl.plusSwitchChannelMap LinearMap.id Ψ +
