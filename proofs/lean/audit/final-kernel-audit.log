ICO.PolarizationOrderedArbitraryControl.one_call_each_diluted_switch_plus {M : Type} [Fintype M] [DecidableEq M]
  {d m n : ℕ} (hm : 0 < m) (hn : 0 < n)
  (tree : ICO.LabelledQueryTree.Tree (Fin m ⊕ Fin n) (Fin d × M) (Fin 2 × Fin d) Finset.univ (Fin d))
  (htree : ICO.PolarizationOrderedArbitraryControl.RealizesLabelledSwitch tree)
  (A_ch B_ch : QIT.Channel (Fin d) (Fin d)) :
  ((ICO.ReducedCircuit.reduce hm hn tree).channel (ICO.PolarizationOrderedArbitraryControl.liftSlotChannel A_ch)
          (ICO.PolarizationOrderedArbitraryControl.liftSlotChannel B_ch)).map =
      ICO.PolarizationOrderedArbitraryControl.dilutedPlusSwitchMap (1 / ↑m) (1 / ↑n) A_ch.map B_ch.map ∧
    (1 / (↑m * ↑n)) •
          ∑ k,
            ∑ l,
              ((ICO.CircuitPolarization.selected tree k l).channel
                  (ICO.PolarizationOrderedArbitraryControl.liftSlotChannel A_ch)
                  (ICO.PolarizationOrderedArbitraryControl.liftSlotChannel B_ch)).map =
        ICO.PolarizationOrderedArbitraryControl.dilutedPlusSwitchMap (1 / ↑m) (1 / ↑n) A_ch.map B_ch.map ∧
      (1 / (↑m * ↑n)) •
          ∑ k,
            ∑ l,
              (tree.channel
                  (Sum.elim
                    (Function.update
                      (fun x => ICO.PolarizationOrderedArbitraryControl.liftSlotChannel (QIT.Channel.idChannel (Fin d)))
                      k (ICO.PolarizationOrderedArbitraryControl.liftSlotChannel A_ch))
                    (Function.update
                      (fun x => ICO.PolarizationOrderedArbitraryControl.liftSlotChannel (QIT.Channel.idChannel (Fin d)))
                      l (ICO.PolarizationOrderedArbitraryControl.liftSlotChannel B_ch)))).map =
        ICO.PolarizationOrderedArbitraryControl.plusSwitchChannelMap ((1 / ↑m) • A_ch.map + (1 - 1 / ↑m) • LinearMap.id)
          ((1 / ↑n) • B_ch.map + (1 - 1 / ↑n) • LinearMap.id)
