                  (Sum.elim
                    (Function.update
                      (fun x => ICO.PolarizationOrderedArbitraryControl.liftSlotChannel (QIT.Channel.idChannel (Fin d)))
                      k (ICO.PolarizationOrderedArbitraryControl.liftSlotChannel A_ch))
                    (Function.update
