/-- Structural recursion for finite integer sums `∑ k < n, f k`. -/
def sumBelow (n : Nat) (f : Nat → Int) : Int :=
  match n with
  | 0 => 0
  | m + 1 => sumBelow m f + f m

/-- Encode a 4-tuple `(a_I, a_O, b_I, b_O)` in base 4. -/
def encode4 (a b c e : Nat) : Nat :=
  ((a * 4 + b) * 4 + c) * 4 + e

