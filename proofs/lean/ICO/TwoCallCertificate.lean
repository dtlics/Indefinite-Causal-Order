/-- Bilinear pairing `v₁ᵀ M v₂` of two sparse integer vectors against `M : Nat → Nat → Int`. -/
def evalBilinear (M : Nat → Nat → Int) (v1 v2 : List (Nat × Int)) : Int :=
  (v1.map fun ic1 =>
    (v2.map fun ic2 => ic1.2 * ic2.2 * M ic1.1 ic2.1).sum).sum

/-- Euclidean inner product `v₁ᵀ v₂` of two sparse integer vectors. -/
def sparseDot (v1 v2 : List (Nat × Int)) : Int :=
  (v1.map fun ic1 =>
    (v2.map fun ic2 => if ic1.1 == ic2.1 then ic1.2 * ic2.2 else 0).sum).sum

/-- Check that within each of the 10 representative sub-blocks, the basis vectors are
mutually orthogonal and have positive squared norm, and that vectors from distinct
sub-blocks in the same charge sector are orthogonal under `I`, `zScaled`, and `zdScaled`. -/
def checkSubblockOrthogonality : Bool :=
  let withinOk := repSubblocks10.all fun blk =>
    let n := blk.length
    (List.range n).all fun a =>
      let va := blk.getD a []
      sparseDot va va > 0 &&
      (List.range n).all fun b =>
        if a == b then true else sparseDot va (blk.getD b []) == 0
  let pairsSameCharge : List (Nat × Nat) := [(0, 1), (0, 2), (0, 3), (1, 2), (1, 3), (2, 3), (4, 5)]
  let crossOk := pairsSameCharge.all fun ab =>
    let blka := repSubblocks10.getD ab.1 []
    let blkb := repSubblocks10.getD ab.2 []
    blka.all fun va =>
      blkb.all fun vb =>
        sparseDot va vb == 0 &&
        evalBilinear zScaled va vb == 0 &&
        evalBilinear zdScaled va vb == 0
  withinOk && crossOk

theorem subblock_orthogonality : checkSubblockOrthogonality = true := by decide

/-- Construct the symmetric integer Gram matrix `B_{a,b} = v_aᵀ M v_b` on a sub-block. -/
def evalSubblockMatrix (M : Nat → Nat → Int) (blk : List (List (Nat × Int))) : List (List Int) :=
  blk.map fun va => blk.map fun vb => evalBilinear M va vb

/-- Verify one step of Bareiss/Sylvester elimination `prev * nextM[i][j] == piv * curM[i+1][j+1] - curM[i+1][0] * curM[0][j+1]`
using only multiplication and subtraction on concrete integer matrices. -/
def verifyBareissRow (prev piv r0 : Int) : List Int → List Int → List Int → Bool
  | [], [], [] => true
  | c :: cs, r0c :: r0cs, q :: qs =>
      prev * q == piv * c - r0 * r0c && verifyBareissRow prev piv r0 cs r0cs qs
  | _, _, _ => false

def verifyBareissStep (prev piv : Int) (row0Tail : List Int) :
    List (List Int) → List (List Int) → Bool
  | [], [] => true
  | (r0 :: rTail) :: rs, nextRow :: nextRs =>
      verifyBareissRow prev piv r0 rTail row0Tail nextRow &&
      verifyBareissStep prev piv row0Tail rs nextRs
  | _, _ => false

/-- Check a precomputed Bareiss Schur-complement chain `[M_1, ..., M_{n-1}]` starting from `M_0`:
verifies that every pivot is strictly positive and every Schur complement step holds. -/
def verifyBareissChain : Int → List (List Int) → List (List (List Int)) → Bool
  | prev, [[piv]], [] => decide (0 < prev) && decide (0 < piv)
  | prev, (piv :: row0Tail) :: restRows, nextM :: restChain =>
      decide (0 < prev) && decide (0 < piv) &&
      verifyBareissStep prev piv row0Tail restRows nextM &&
      verifyBareissChain piv nextM restChain
  | _, _, _ => false

