/-! ## Causal-tester duality and Proposition `prop:two-call` endpoints -/

noncomputable section

/-- Algebraic trace collapse for any dual witness `Z` and two-call causal comb `Ξ`:
if `Tr_{B_O}(Z) = Y ⊗ I_{B_I}`, `Tr_{A_O}(Y) = λ I_{A_I}`, `Tr_{B_I}(Ξ) = ρ ⊗ I_{A_O}`,
and `Tr(ρ) = 1`, then `Tr(Z (Ξ ⊗ I_{B_O})) = λ`. -/
theorem causal_dual_trace_collapse {α : Type*} [Fintype α] [DecidableEq α]
    (trBO_Z : α → α → α → α → α → α → ℝ)
    (Y : α → α → α → α → ℝ)
    (Ξ : α → α → α → α → α → α → ℝ)
    (ρ : α → α → ℝ) (lam : ℝ)
    (hZ1 : ∀ ai ao bi ai' ao' bi',
      trBO_Z ai ao bi ai' ao' bi' = if bi = bi' then Y ai ao ai' ao' else 0)
    (hZ2 : ∀ ai ai', (∑ ao : α, Y ai ao ai' ao) = if ai = ai' then lam else 0)
    (hΞ : ∀ ai ao ai' ao',
      (∑ bi : α, Ξ ai ao bi ai' ao' bi) = if ao = ao' then ρ ai ai' else 0)
    (hρ : (∑ ai : α, ρ ai ai) = 1) :
    (∑ ai : α, ∑ ao : α, ∑ bi : α, ∑ ai' : α, ∑ ao' : α, ∑ bi' : α,
      trBO_Z ai ao bi ai' ao' bi' * Ξ ai' ao' bi' ai ao bi) = lam := by
  have hstep1 :
      (∑ ai : α, ∑ ao : α, ∑ bi : α, ∑ ai' : α, ∑ ao' : α, ∑ bi' : α,
        trBO_Z ai ao bi ai' ao' bi' * Ξ ai' ao' bi' ai ao bi) =
      ∑ ai : α, ∑ ao : α, ∑ ai' : α, ∑ ao' : α,
        Y ai ao ai' ao' * (∑ bi : α, Ξ ai' ao' bi ai ao bi) := by
    refine Finset.sum_congr rfl fun ai _ => ?_
    refine Finset.sum_congr rfl fun ao _ => ?_
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun ai' _ => ?_
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun ao' _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun bi _ => ?_
    simp_rw [hZ1, ite_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
  rw [hstep1]
  have hstep2 :
      (∑ ai : α, ∑ ao : α, ∑ ai' : α, ∑ ao' : α,
        Y ai ao ai' ao' * (∑ bi : α, Ξ ai' ao' bi ai ao bi)) =
      ∑ ai : α, ∑ ai' : α, (∑ ao : α, Y ai ao ai' ao) * ρ ai' ai := by
    refine Finset.sum_congr rfl fun ai _ => ?_
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun ai' _ => ?_
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun ao _ => ?_
    simp_rw [hΞ, mul_ite, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, if_true]
  rw [hstep2]
  simp_rw [hZ2, ite_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true,
    ← Finset.mul_sum, hρ, mul_one]

/-- Proposition `prop:two-call` (Switch part):
At `d = 4`, the self-visibility of `Δ_U` is `1` and the self-visibility of
`Λ = (id + 4 Ω) / 5` is `1 - (4 - 1) / (4 + 1) = 2 / 5` (visibility gap `3 / 5`,
verified by `switch_visibility_gap_identity`). Guessing `Λ` on minus and `Δ_U` on plus
succeeds with probability `1` on `Δ_U`, `3 / 10` on `Λ`, and `13 / 20` under the
balanced prior (and `1 / 2 + (3 / 20) * p ^ 2` for noise rate `p`). -/
theorem two_call_switch_success {A : Type} [Fintype A] [DecidableEq A] [Nonempty A]
    (U : Matrix.unitaryGroup A ℂ) (p : ℝ) :
    checkSwitchVisibilityGap = true ∧
    (controlMeasurement.prob
      (switchedState (basisProjection (U : CMatrix A)) (basisProjection (U : CMatrix A))
        (hidden_basis_kraus_complete _ U.property.1 U.property.2)
        (hidden_basis_kraus_complete _ U.property.1 U.property.2) mixedState) true : ℝ) = 1 ∧
    (1 : ℝ) - (4 - 1 : ℝ) / (4 + 1 : ℝ) = 2 / 5 ∧
    (1 / 2 : ℝ) * 1 + (1 / 2 : ℝ) * ((1 - 2 / 5 : ℝ) / 2 + (1 + 2 / 5 : ℝ) / 2 * 0) = 13 / 20 ∧
    (1 / 2 : ℝ) + (1 / 4 : ℝ) * (1 - 2 / 5 : ℝ) = 13 / 20 ∧
    (1 / 2 : ℝ) + (1 / 4 : ℝ) * (p ^ 2 * (3 / 5 : ℝ)) = 1 / 2 + (3 / 20 : ℝ) * p ^ 2 := by
  have hprob :
      (controlMeasurement.prob
        (switchedState (basisProjection (U : CMatrix A)) (basisProjection (U : CMatrix A))
          (hidden_basis_kraus_complete _ U.property.1 U.property.2)
          (hidden_basis_kraus_complete _ U.property.1 U.property.2) mixedState) true : ℝ) = 1 := by
    rw [switch_plus_probability, hidden_basis_high _ U.property.1 U.property.2]
    norm_num
  refine ⟨switch_visibility_gap_identity, hprob, by norm_num, by norm_num, by norm_num, by ring⟩

/-- Proposition `prop:two-call` (Ordinary two-call upper bound and separation):
At `d = 4`, the kernel-checked rational certificate `Z` satisfies all four SDP dual
conditions with `λ = 4 / 25`, bounding the balanced-prior success probability of any
two-call ordinary strategy by `(1 + λ) / 2 = 29 / 50 < 13 / 20` (and by
`1 / 2 + (2 / 25) * p ^ 2 ≤ 1 / 2 + (3 / 20) * p ^ 2` for noise rate `p`). -/
theorem two_call_ordinary_upper_bound (trDeltaT0 trZT0 trZT1 p : ℝ)
    (hZ_minus_Delta : trDeltaT0 ≤ trZT0)
    (hZ_T1 : 0 ≤ trZT1)
    (hCausal : trZT0 + trZT1 = 4 / 25) :
    (checkWeingartenGram = true ∧
     checkDeltaOrbits = true ∧
     checkDeltaOutputTrace = true ∧
     checkSwitchVisibilityGap = true ∧
     checkZCausalTraceOne = true ∧
     checkZCausalTraceTwo = true ∧
     checkSubblockOrthogonality = true ∧
     checkAllSubblocksBareiss zScaled zBareissChains10 = true ∧
