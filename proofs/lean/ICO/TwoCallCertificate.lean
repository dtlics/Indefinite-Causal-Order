  have hp2 : 0 ≤ p ^ 2 := sq_nonneg p
  have hp_le : p ^ 2 * trDeltaT0 ≤ p ^ 2 * (4 / 25) :=
    mul_le_mul_of_nonneg_left htr hp2
  refine ⟨two_call_certificate_verified, by linarith, by norm_num, by norm_num,
