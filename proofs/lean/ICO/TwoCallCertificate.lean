/-- Apply a permutation `p` (given as a 4-element list) to `x ∈ {0,1,2,3}`. -/
def applyPerm (p : List Nat) (x : Nat) : Nat :=
  p.getD x 0

/-- Inverse of a permutation `p` on `{0,1,2,3}`. -/
def invPerm (p : List Nat) (y : Nat) : Nat :=
  if applyPerm p 0 == y then 0
  else if applyPerm p 1 == y then 1
  else if applyPerm p 2 == y then 2
  else 3

/-- Number of disjoint cycles of a permutation `p` on `{0,1,2,3}`. -/
def cycleCount4 (p : List Nat) : Nat :=
  let p0 := applyPerm p 0
  let p1 := applyPerm p 1
  let p2 := applyPerm p 2
  let p3 := applyPerm p 3
  let c1 := (if p0 == 0 then 1 else 0) + (if p1 == 1 then 1 else 0) +
            (if p2 == 2 then 1 else 0) + (if p3 == 3 then 1 else 0)
  let two0 := if p0 != 0 && applyPerm p p0 == 0 then 1 else 0
  let two1 := if p1 != 1 && applyPerm p p1 == 1 then 1 else 0
  let two2 := if p2 != 2 && applyPerm p p2 == 2 then 1 else 0
  let two3 := if p3 != 3 && applyPerm p p3 == 3 then 1 else 0
  let c2 := (two0 + two1 + two2 + two3) / 2
  let rem := 4 - c1 - 2 * c2
  let c34 := if rem == 0 then 0 else 1
  c1 + c2 + c34

/-- Composition `p⁻¹ ∘ q` on `{0,1,2,3}`. -/
def compInvPerm (p q : List Nat) : List Nat :=
  [invPerm p (applyPerm q 0), invPerm p (applyPerm q 1),
   invPerm p (applyPerm q 2), invPerm p (applyPerm q 3)]

/-- Right-hand side `13440 * b_σ` of the `d = 4` fourth-moment Weingarten system:
`13440` when `σ` preserves `{0, 1}` (and hence `{2, 3}`), and `13440 / 4 = 3360` otherwise. -/
def weingartenRhs13440 (p : List Nat) : Int :=
  let p0 := applyPerm p 0
  let p1 := applyPerm p 1
  if (p0 == 0 && p1 == 1) || (p0 == 1 && p1 == 0) then 13440 else 3360

/-- Exact integer numerator `13440 * c_σ` of the `d = 4` Weingarten solution:
`34` if `σ({0,1}) = {0,1}`, `6` if `σ({0,1}) = {2,3}`, and `-1` otherwise. -/
def weingartenNum13440 (p : List Nat) : Int :=
  let p0 := applyPerm p 0
  let p1 := applyPerm p 1
  if (p0 == 0 && p1 == 1) || (p0 == 1 && p1 == 0) then 34
  else if (p0 == 2 && p1 == 3) || (p0 == 3 && p1 == 2) then 6
  else -1

/-- Check that `weingartenNum13440` satisfies all 24 equations of the `d = 4`
Haar fourth-moment Gram system `∑_τ 4^(#cycles(σ⁻¹ τ)) (13440 c_τ) = 13440 b_σ`. -/
def checkWeingartenGram : Bool :=
  perms24.all fun p =>
    let lhs := (perms24.map fun q =>
      ((4 ^ cycleCount4 (compInvPerm p q) : Nat) : Int) * weingartenNum13440 q).sum
    lhs == weingartenRhs13440 p

theorem weingarten_gram_identity : checkWeingartenGram = true := by decide

/-- Unnormalized two-copy Haar Choi operator `W_0 = E_U [J(Δ_U)^⊗2]` scaled by `4200`. -/
def w0Scaled4200 (i j : Nat) : Int :=
  let ai := i / 64 % 4
  let ao := i / 16 % 4
  let bi := i / 4 % 4
  let bo := i % 4
  let ai' := j / 64 % 4
  let ao' := j / 16 % 4
  let bi' := j / 4 % 4
  let bo' := j % 4
  let r0 := ai'; let r1 := ao; let r2 := bi'; let r3 := bo
  let c0 := ai;  let c1 := ao'; let c2 := bi;  let c3 := bo'
  if r0 + r1 + r2 + r3 != c0 + c1 + c2 + c3 then 0
  else
    let col := [c0, c1, c2, c3]
    5 * (perms24.map fun p =>
      if r0 == col.getD (applyPerm p 0) 0 &&
         r1 == col.getD (applyPerm p 1) 0 &&
         r2 == col.getD (applyPerm p 2) 0 &&
         r3 == col.getD (applyPerm p 3) 0 then
        weingartenNum13440 p
      else 0).sum

/-- Single-copy Choi matrix `5 * J(Λ)` for `Λ = (id + 4 Ω) / 5` at `d = 4`:
`5 * J(Λ)_{(a,b),(c,e)} = δ_{a,c} δ_{b,e} + δ_{a,b} δ_{c,e}`. -/
def jLambdaScaled5 (ab ce : Nat) : Int :=
  let a := ab / 4 % 4
  let b := ab % 4
  let c := ce / 4 % 4
  let e := ce % 4
  (if a == c && b == e then 1 else 0) + (if a == b && c == e then 1 else 0)

/-- Two-copy Choi matrix `W_1 = J(Λ)^⊗2` scaled by `4200`. -/
def w1Scaled4200 (i j : Nat) : Int :=
  168 * jLambdaScaled5 (i / 16) (j / 16) * jLambdaScaled5 (i % 16) (j % 16)

