/-- Check that `Z` satisfies the first causal dual trace equality
`4 * Tr_{B_O}(Z)_{(a_I,a_O,b_I),(a'_I,a'_O,b'_I)} = δ_{b_I,b'_I} * Tr_{B_I,B_O}(Z)_{(a_I,a_O),(a'_I,a'_O)}`
(fixing `a_I = 0` by `S_4` invariance of `zScaled` and sweeping all `ao, ai', ao', bi, bi'`). -/
def checkZCausalTraceOne : Bool :=
  (List.range 4).all fun ao =>
    (List.range 16).all fun va =>
      let ai' := va / 4 % 4
      let ao' := va % 4
      let trBIBO := sumBelow 16 fun xbo =>
        let x := xbo / 4
        let bo := xbo % 4
        zScaled (encode4 0 ao x bo) (encode4 ai' ao' x bo)
      (List.range 4).all fun bi =>
        (List.range 4).all fun bi' =>
          let lhs := 4 * sumBelow 4 fun bo =>
            zScaled (encode4 0 ao bi bo) (encode4 ai' ao' bi' bo)
          let rhs := if bi == bi' then trBIBO else 0
          lhs == rhs

theorem z_causal_trace_one : checkZCausalTraceOne = true := by decide

/-- Check that `Z` satisfies the second causal dual trace equality
`Tr_{A_O}(Y) = (4/25) I_{A_I}`, i.e., `Tr_{A_O,B_I,B_O}(640000000 * Z)_{a_I, a'_I} = 409600000 * δ_{a_I, a'_I}`. -/
def checkZCausalTraceTwo : Bool :=
  (List.range 4).all fun ai' =>
    let lhs := sumBelow 64 fun idx =>
      let ao := idx / 16 % 4
      let bi := idx / 4 % 4
      let bo := idx % 4
      zScaled (encode4 0 ao bi bo) (encode4 ai' ao bi bo)
    let rhs : Int := if 0 == ai' then 409600000 else 0
    lhs == rhs

theorem z_causal_trace_two : checkZCausalTraceTwo = true := by decide

/-- Scaled difference `13440000000 * (Z - Δ) = 21 * (640000000 * Z) - 3200000 * (4200 * Δ)`. -/
def zdScaled (i j : Nat) : Int :=
  21 * zScaled i j - 3200000 * deltaScaled4200 i j

/-- Charge vector `(-e_a + e_b - e_c + e_d)` for `idx = (a, b, c, d)`. -/
def chargeVec (idx : Nat) : List Int :=
  let a := idx / 64 % 4
  let b := idx / 16 % 4
  let c := idx / 4 % 4
  let e := idx % 4
  (List.range 4).map fun k =>
    (if b == k then (1 : Int) else 0) + (if e == k then 1 else 0) -
    (if a == k then 1 else 0) - (if c == k then 1 else 0)

