inductive DataTree where
  | leaf : Int → Int → DataTree
  | branch : DataTree → DataTree → DataTree

def lookup : Nat → Nat → DataTree → Int × Int
  | 0, _, .leaf a b => (a, b)
  | d + 1, i, .branch l r =>
    if i < 2^d then lookup d i l else lookup d (i - 2^d) r
  | _, _, _ => (0, 0)

