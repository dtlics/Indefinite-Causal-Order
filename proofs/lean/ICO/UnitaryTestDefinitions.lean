abbrev GPair := Int × Int
def gpAdd (a b : GPair) : GPair := (a.1+b.1,a.2+b.2)
def gpMul (a b : GPair) : GPair := (a.1*b.1-a.2*b.2,a.1*b.2+a.2*b.1)
def gpSum (n : Nat) (f : Nat → GPair) : GPair :=
  (sumBelow n (fun i => (f i).1), sumBelow n (fun i => (f i).2))
structure QData where
  w : Int
  x : Int
  y : Int
  z : Int
  deriving DecidableEq
def qEntry (q : QData) (r c : Nat) : GPair :=
  if r == 0 then (if c == 0 then (q.w,q.z) else (q.y,q.x))
  else (if c == 0 then (-q.y,q.x) else (q.w,-q.z))
def qNorm (q : QData) : Int := q.w*q.w+q.x*q.x+q.y*q.y+q.z*q.z
