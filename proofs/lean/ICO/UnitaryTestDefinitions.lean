def outIndex (i : Nat) : Nat := (i / 64 % 2) * 4 + (i / 2 % 2) * 2 + i % 2
def testRow (r i : Nat) : GPair := gpMul (annData r (outIndex i))
  (gpMul (qEntry (uData r) (i/16%2) (i/32%2))
    (qEntry (vData r) (i/4%2) (i/8%2)))
def qProduct (q s : QData) (r c : Nat) : GPair :=
  gpSum 2 (fun k => gpMul (qEntry q r k) (qEntry s k c))
def fourOutput (r b o : Nat) : GPair :=
  let p := o/4%2
  let c := o/2%2
  let t := o%2
  if b == 0 then (if p == t then (1,0) else (0,0))
  else if b == 1 then qEntry (uData r) t p
  else if b == 2 then qEntry (vData r) t p
  else if c == 0 then qProduct (vData r) (uData r) t p
  else qProduct (uData r) (vData r) t p
def annihilation (r b : Nat) : GPair :=
  gpSum 8 (fun o => gpMul (annData r o) (fourOutput r b o))
end ICO.UnitaryTestCertificates
